# Execution mode: paper (default) or live (live adapters must be wired first)
OUTCRY_MODE=paper
PORT=8787
# New simulated pump.fun launch every N ms in paper mode (0 to disable)
OUTCRY_SIM_LAUNCH_MS=20000

# --- Saved state ---
# Postgres (Render sets this from the blueprint's database). Takes priority over the file.
# DATABASE_URL=postgres://user:pass@host:5432/outcry
# Local development: save to a JSON file instead
# OUTCRY_STATE_FILE=./data/state.json
# Passkeys are bound to the site's address; set this if the server sits behind a proxy that hides it
# OUTCRY_ORIGIN=https://outcry-7yp6.onrender.com

# --- Real market in paper mode ---
# Live prices (Binance / Jupiter, Twelve Data for stocks) and real candles for charts and agents
# OUTCRY_LIVE_PRICES=1
# Real pump.fun launches from PumpPortal's public stream (replaces the simulated launches)
# OUTCRY_PUMP_FEED=pumpportal
# Optional, paid: PumpPortal trade data (0.01 SOL per 10,000 trades). Without it, holder counts
# for new launches come from Jupiter's token API, polled every 5s.
# PUMPPORTAL_API_KEY=

# Solana RPC for on-chain holder checks (default: public RPC). A Helius key is faster and not rate-limited.
# HELIUS_API_KEY=
# SOLANA_RPC_URL=

# --- Paper trading realism ---
# Estimated network cost per transaction in USD (base + priority fee / tip)
# OUTCRY_NETFEE_PUMP_USD=0.15
# OUTCRY_NETFEE_SOLANA_USD=0.01
# OUTCRY_NETFEE_BASE_USD=0.02
# OUTCRY_NETFEE_ETH_USD=0.5
# Live memecoins fill at the next price update after the order (max wait, ms)
# OUTCRY_PAPER_FILL_DELAY_MS=7000

# --- Backtest data ---
# Real stock candles (AAPL, NVDA...) from Twelve Data; free key at twelvedata.com.
# Crypto candles come from Binance's public market-data API without a key.
TWELVEDATA_API_KEY=
# Set to 0 to always backtest on simulated prices
# OUTCRY_REAL_HISTORY=1

# --- Models (all optional; without keys an offline intent engine is used) ---
# T2 frontier tier: Claude Opus 5.5 via Anthropic
ANTHROPIC_API_KEY=
# T0/T1 tiers via OpenRouter with your own provider keys (BYOK)
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Or a self-hosted LiteLLM gateway
# LLM_GATEWAY_URL=http://localhost:4000/v1
# LLM_GATEWAY_KEY=
# Per-tier overrides (provider: anthropic | openrouter | gateway)
# OUTCRY_T0_MODEL=qwen/qwen3.7-flash
# OUTCRY_T1_MODEL=google/gemini-3.8-flash
# OUTCRY_T2_MODEL=claude-opus-5-5
# OUTCRY_T2_PROVIDER=anthropic

# Marketplace leaderboard: an agent is ranked after this many hours live and closed trades
# OUTCRY_RANK_MIN_HOURS=24
# OUTCRY_RANK_MIN_TRADES=3

# Live trading pilot (real money). Wallets on Turnkey, swaps via Jupiter Swap V2.
# TURNKEY_ORGANIZATION_ID=
# TURNKEY_API_PUBLIC_KEY=
# TURNKEY_API_PRIVATE_KEY=
# JUPITER_API_KEY=            # developers.jup.ag/portal
# OUTCRY_LIVE_TRADING=1       # master switch
# OUTCRY_LIVE_ALLOWLIST=thiago   # comma-separated @handles allowed to trade real money, or * for everyone with a passkey
# OUTCRY_LIVE_MAX_ORDER_USD=25
# OUTCRY_LIVE_MAX_DAILY_USD=100
# OUTCRY_LIVE_RESERVE_SOL=0.01
# Outcry's fee on real trades via the Jupiter Referral Program (referral.jup.ag).
# JUPITER_REFERRAL_ACCOUNT=     # your referral account address (Jupiter Ultra project)
# JUPITER_REFERRAL_FEE_BPS=50   # 0.5%; Jupiter keeps 20% of it
# Max AI spend per user per day before the chat falls back to the offline engine.
# OUTCRY_MAX_AI_USD_PER_USER=0.5
# Handles that can approve real-money access requests (Admin button in the terminal).
# OUTCRY_ADMINS=redtrap
# Max budget for one real-money agent.
# OUTCRY_LIVE_AGENT_MAX_USD=50
