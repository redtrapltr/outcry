# Execution mode: paper (default) or live (live adapters must be wired first)
OUTCRY_MODE=paper
PORT=8787
# New simulated pump.fun launch every N ms in paper mode (0 to disable)
OUTCRY_SIM_LAUNCH_MS=20000

# --- Backtest data ---
# Real stock candles (AAPL, NVDA...) from Twelve Data; free key at twelvedata.com.
# Crypto candles come from Binance's public market-data API without a key.
TWELVEDATA_API_KEY=
# Set to 0 to always backtest on simulated prices
# OUTCRY_REAL_HISTORY=1

# --- Models (all optional; without keys an offline intent engine is used) ---
# T2 frontier tier: Claude Opus 5.5 via Anthropic
ANTHROPIC_API_KEY=
# T0/T1 tiers via OpenRouter with your own provider keys (BYOK)
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Or a self-hosted LiteLLM gateway
# LLM_GATEWAY_URL=http://localhost:4000/v1
# LLM_GATEWAY_KEY=
# Per-tier overrides (provider: anthropic | openrouter | gateway)
# OUTCRY_T0_MODEL=qwen/qwen3.7-flash
# OUTCRY_T1_MODEL=google/gemini-3.8-flash
# OUTCRY_T2_MODEL=claude-opus-5-5
# OUTCRY_T2_PROVIDER=anthropic
